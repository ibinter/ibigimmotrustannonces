{
  "manifest_version": 3,
  "name": "IBIG Immo Trust — Capteur",
  "version": "1.4.0",
  "description": "Capture automatique des annonces immobilières Facebook vers IBIG Immo Trust",
  "permissions": ["activeTab", "scripting", "storage", "alarms", "tabs"],
  "host_permissions": [
    "https://www.facebook.com/*",
    "https://web.whatsapp.com/*",
    "https://api.ibigimmotrust.com/*",
    "https://ibigimmotrust.com/*",
    "https://*.ibigimmotrust.com/*",
    "https://*.fbcdn.net/*",
    "https://*.fbsbx.com/*",
    "https://*.facebook.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16":  "icon-16.png",
    "32":  "icon-32.png",
    "48":  "icon-48.png",
    "128": "icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16":  "icon-16.png",
      "32":  "icon-32.png",
      "48":  "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.facebook.com/*", "https://web.whatsapp.com/*", "https://ibigimmotrust.com/*", "https://*.ibigimmotrust.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
